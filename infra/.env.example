# Copy to infra/.env and fill in. Never commit the filled file.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=artrat
MINIO_ROOT_PASSWORD=change-me-too
SEARXNG_SECRET=generate-a-long-random-string

# Backend (api + agent roles)
ARTRAT_DATABASE_URL=postgresql+psycopg://artrat:change-me@postgres:5432/artrat
ARTRAT_BROWSER_URL=http://browser:8090
ARTRAT_SEARXNG_URL=http://searxng:8080
ARTRAT_OPENROUTER_API_KEY=your-openrouter-api-key
ARTRAT_OPENROUTER_MODEL=google/gemini-2.5-flash

# Browser worker (browser-use). Telemetry stays off: the worker must not phone home.
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false
